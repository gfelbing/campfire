{
  "name": "campfire-client",
  "private": true,
  "version": "0.0.8",
  "type": "module",
  "description": "Campfire web client: TS + Vite + PixiJS, built and embedded into the server binary.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:e2e": "CAMPFIRE_DEBUG=1 npm run build",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "node ../third_party/moq-watch/patch.mjs && node ../third_party/moq-publish/patch.mjs"
  },
  "dependencies": {
    "@moq/net": "^0.4.7",
    "@moq/publish": "^0.5.6",
    "@moq/signals": "^0.2.6",
    "@moq/watch": "^0.6.6",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^5.7",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.7",
    "vitest": "^5.1.0"
  }
}
